# Copy this file to .env.local and fill in values from `supabase status`
# after running `supabase start`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used sparingly, only where
# RLS must be intentionally bypassed (e.g. system/audit writes).
SUPABASE_SERVICE_ROLE_KEY=
